   "description": "The Unique ID of your Lark App from the Lark Developer Console."
  },
  {
   "fieldname": "app_secret",
   "fieldtype": "Password",
   "label": "Lark App Secret",
   "description": "The Secret Key for your Lark App, used for secure authentication."
  },
  {
   "fieldname": "column_break_auth",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_auth_success",
