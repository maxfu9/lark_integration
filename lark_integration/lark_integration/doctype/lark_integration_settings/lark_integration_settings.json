   "label": "Last Successful Auth",
   "read_only": 1
  },
  {
   "fieldname": "section_break_runtime",
   "fieldtype": "Section Break",
   "label": "Runtime"
  },
  {
   "fieldname": "mapping_note",
   "fieldtype": "HTML",
   "label": "Sync Mapping",
   "options": "<div style='padding: 10px; background-color: var(--bg-light-gray); border-radius: 4px; border-left: 4px solid var(--blue-500);'>Configure table IDs and sync scope in <a href='/app/lark-sync-document' style='font-weight: bold; text-decoration: underline;'>Lark Sync Document</a>.</div>"
  },
  {
   "fieldname": "section_break_runtime_fields",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "column_break_runtime",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
   "fieldname": "enable_api_logging",
   "fieldtype": "Check",
   "label": "Enable API Logging",
   "description": "Records all Lark API requests and responses in 'Lark API Log' for debugging and audit purposes."
  },
  {
   "default": "20",
   "fieldname": "request_timeout",
   "fieldtype": "Int",
   "label": "Request Timeout (Seconds)",
   "description": "Maximum seconds to wait for a response from Lark before timing out. Default is 20 seconds."
  },
  {
   "fieldname": "tab_lark_drive",
   "fieldtype": "Tab Break",
   "label": "Lark Drive"
  },
  {
   "default": "0",
   "fieldname": "drive_upload_enabled",
   "fieldtype": "Check",
   "label": "Enable Drive Uploads",
   "description": "Automatically upload ERPNext document attachments to your Lark Drive."
  },
  {
   "fieldname": "drive_folder_token",
   "fieldtype": "Data",
   "label": "Target Folder Token",
   "description": "The token of the Lark Drive folder where attachments will be stored."
  },
  {
   "default": "1",
   "fieldname": "replace_erpnext_files_after_upload",
   "fieldtype": "Check",
   "label": "Delete Local Files After Upload",
   "description": "Save ERPNext server space by deleting local file content once successfully uploaded to Lark."
  },
  {
   "fieldname": "tab_backup",
   "fieldtype": "Tab Break",
   "label": "Backup"
  },
  {
   "default": "0",
   "fieldname": "backup_enabled",
   "fieldtype": "Check",
   "label": "Enable Automated Backup",
   "description": "Periodically upload ERPNext database content and personal files to Lark."
  },
  {
   "default": "Daily",
   "fieldname": "backup_frequency",
   "fieldtype": "Select",
   "label": "Schedule Type",
   "description": "Choose between Hourly, Daily, or Weekly execution.",
   "options": "Hourly\nDaily\nWeekly"
  },
  {
   "default": "24",
   "depends_on": "eval:doc.backup_frequency == 'Hourly'",
   "fieldname": "backup_interval_hours",
   "fieldtype": "Int",
   "label": "Backup Interval (Hours)"
  },
  {
   "depends_on": "eval:['Daily', 'Weekly'].includes(doc.backup_frequency)",
   "fieldname": "backup_time",
   "fieldtype": "Time",
   "label": "Backup Time (Daily/Weekly)"
  },
  {
   "default": "Sunday",
   "depends_on": "eval:doc.backup_frequency == 'Weekly'",
   "fieldname": "backup_weekday",
   "fieldtype": "Select",
   "label": "Backup Weekday (Weekly)",
   "options": "Monday\nTuesday\nWednesday\nThursday\nFriday\nSaturday\nSunday"
  },
  {
   "fieldname": "backup_site",
   "fieldtype": "Data",
   "label": "Target Site",
   "description": "Leave blank to backup the current site. Use this for multi-tenant setups."
  },
  {
   "default": "0",
   "fieldname": "backup_files",
   "fieldtype": "Check",
   "label": "Include Site Files",
   "description": "If enabled, also backups your public and private file attachments."
  },
  {
   "default": "5",
   "fieldname": "backup_limit",
   "fieldtype": "Int",
   "label": "Retention Limit (Number of Backups)"
  },
  {
   "fieldname": "backup_lark_folder",
   "fieldtype": "Data",
   "label": "Lark Backup Folder Token",
   "description": "The token of the folder where backup archives will be uploaded."
  },
  {
   "fieldname": "column_break_backup",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
