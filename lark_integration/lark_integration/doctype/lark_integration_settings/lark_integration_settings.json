 "fields": [
  {
   "fieldname": "tab_integration",
   "fieldtype": "Tab Break",
   "label": "Integration"
  },
  {
   "default": "1",
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enable Integration",
   "description": "Master toggle to enable or disable all Lark integration features."
  },
  {
   "fieldname": "section_break_auth",
   "fieldtype": "Section Break",
   "label": "Authentication"
